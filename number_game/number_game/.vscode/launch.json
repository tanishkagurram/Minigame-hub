<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mystery Number Guessing Game</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: background 0.5s ease;
            overflow: hidden;
        }

        /* Color themes */
        .bg-level-1 { background: linear-gradient(135deg, #8a9a7e, #6b7f5e); }
        .bg-level-2 { background: linear-gradient(135deg, #6b7f5e, #8a9a7e); }
        .bg-level-3 { background: linear-gradient(135deg, #8a9a7e, #6b7f5e); }
        .bg-level-4 { background: linear-gradient(135deg, #6b7f5e, #7a8a6e); }
        .bg-level-5 { background: linear-gradient(135deg, #7a8a6e, #6b7f5e); }

        .container {
            background: #f5f5f0;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(107, 127, 94, 0.3);
            padding: 40px;
            max-width: 500px;
            width: 90%;
            position: relative;
            z-index: 10;
        }

        /* FIXED: Removed duplicate position property */
        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            background-color: #6b7f5e;
            animation: confetti-fall 3s linear forwards;
            z-index: 1000;
            pointer-events: none;
        }

        @keyframes confetti-fall {
            0% {
                transform: translateY(-100vh) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(100vh) rotate(720deg);
                opacity: 0;
            }
        }

        /* Success Burst Particles */
        .success-particle {
            position: fixed;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            pointer-events: none;
            z-index: 1000;
        }

        @keyframes particle-burst {
            0% {
                transform: translate(0, 0) scale(1);
                opacity: 1;
            }
            100% {
                transform: translate(var(--x), var(--y)) scale(0);
                opacity: 0;
            }
        }

        /* Fireworks Effect */
        .firework {
            position: fixed;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            pointer-events: none;
            z-index: 1000;
        }

        @keyframes firework-burst {
            0% {
                transform: translate(0, 0);
                opacity: 1;
            }
            100% {
                transform: translate(var(--fx), var(--fy));
                opacity: 0;
            }
        }

        /* Stars Animation for Correct Answer */
        .star-particle {
            position: fixed;
            font-size: 30px;
            animation: star-rise 2s ease-out forwards;
            z-index: 1000;
            pointer-events: none;
        }

        @keyframes star-rise {
            0% {
                transform: translateY(0) scale(0) rotate(0deg);
                opacity: 1;
            }
            50% {
                transform: translateY(-100px) scale(1.2) rotate(180deg);
                opacity: 1;
            }
            100% {
                transform: translateY(-200px) scale(0) rotate(360deg);
                opacity: 0;
            }
        }

        /* Shake Animation for Wrong Answer */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            10%, 30%, 50%, 70%, 90% { transform: translateX(-10px); }
            20%, 40%, 60%, 80% { transform: translateX(10px); }
        }

        .shake-animation {
            animation: shake 0.5s ease-in-out;
        }

        /* Red Flash for Wrong Answer */
        @keyframes red-flash {
            0%, 100% { background: #f5f5f0; }
            50% { background: #ffebee; }
        }

        .red-flash {
            animation: red-flash 0.5s ease-in-out;
        }

        /* Bounce Animation for Correct Answer */
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-30px); }
            60% { transform: translateY(-15px); }
        }

        .bounce-animation {
            animation: bounce 1s ease;
        }

        /* Scale Up Animation for Correct */
        @keyframes scale-up {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .scale-up-animation {
            animation: scale-up 0.6s ease-in-out;
        }

        /* Pulse Animation */
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        .pulse-animation {
            animation: pulse 0.5s ease-in-out;
        }

        /* Glow Effect for Correct Answer */
        @keyframes glow {
            0%, 100% { box-shadow: 0 20px 60px rgba(107, 127, 94, 0.3); }
            50% { box-shadow: 0 0 40px rgba(107, 127, 94, 1), 0 0 60px rgba(138, 154, 126, 0.8); }
        }

        .glow-animation {
            animation: glow 1s ease-in-out;
        }

        /* Sad Emoji Animation */
        .sad-emoji {
            position: fixed;
            font-size: 60px;
            animation: sad-fall 2s ease-out forwards;
            z-index: 1000;
            pointer-events: none;
        }

        @keyframes sad-fall {
            0% {
                transform: translateY(-100px) rotate(0deg) scale(0);
                opacity: 1;
            }
            50% {
                transform: translateY(150px) rotate(90deg) scale(1.2);
                opacity: 1;
            }
            100% {
                transform: translateY(400px) rotate(180deg) scale(0);
                opacity: 0;
            }
        }

        /* Thunder/Lightning Flash for Wrong Answer */
        @keyframes lightning-flash {
            0%, 20%, 40%, 60%, 80%, 100% { opacity: 0; }
            10%, 30%, 50%, 70%, 90% { opacity: 0.8; }
        }

        .lightning {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.9);
            z-index: 999;
            pointer-events: none;
            animation: lightning-flash 0.5s;
        }

        /* Hint Reveal Animation */
        @keyframes hint-slide-in {
            0% {
                opacity: 0;
                transform: translateX(-50px);
            }
            100% {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .hint-reveal {
            animation: hint-slide-in 0.5s ease-out;
        }

        /* Light Bulb Glow for Hint */
        @keyframes bulb-glow {
            0%, 100% { 
                filter: brightness(1);
                transform: scale(1);
            }
            50% { 
                filter: brightness(2) drop-shadow(0 0 10px #ffd700);
                transform: scale(1.3);
            }
        }

        .bulb-glow {
            animation: bulb-glow 0.8s ease-in-out;
        }

        /* Sparkle Effect for Hints */
        .sparkle {
            position: fixed;
            font-size: 20px;
            animation: sparkle-float 1.5s ease-out forwards;
            z-index: 1000;
            pointer-events: none;
        }

        @keyframes sparkle-float {
            0% {
                transform: translate(0, 0) scale(0);
                opacity: 1;
            }
            50% {
                transform: translate(var(--sx), -50px) scale(1);
                opacity: 1;
            }
            100% {
                transform: translate(var(--sx), -100px) scale(0);
                opacity: 0;
            }
        }

        /* Rainbow Border Flash for Correct */
        @keyframes rainbow-border {
            0% { border-color: #6b7f5e; }
            20% { border-color: #ffd700; }
            40% { border-color: #ff6b6b; }
            60% { border-color: #4ecdc4; }
            80% { border-color: #95e1d3; }
            100% { border-color: #6b7f5e; }
        }

        .rainbow-border {
            animation: rainbow-border 1s ease-in-out;
            border: 3px solid;
        }

        /* Floating Numbers for Wrong Answer */
        .floating-number {
            position: fixed;
            font-size: 40px;
            font-weight: bold;
            color: #ff6b6b;
            animation: float-away 2s ease-out forwards;
            z-index: 1000;
            pointer-events: none;
        }

        @keyframes float-away {
            0% {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
            100% {
                transform: translateY(-200px) scale(0);
                opacity: 0;
            }
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .level-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .level-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: bold;
            font-size: 18px;
            color: #6b7f5e;
        }

        .score-box {
            text-align: right;
        }

        .score-label {
            font-size: 12px;
            color: #6b7f5e;
        }

        .score-value {
            font-size: 24px;
            font-weight: bold;
            color: #6b7f5e;
        }

        .title {
            font-size: 36px;
            color: #6b7f5e;
            margin: 15px 0 10px 0;
        }

        .subtitle {
            color: #8a9a7e;
            font-size: 16px;
        }

        .current-score-box {
            background: linear-gradient(135deg, #e8ebe4, #f5f5f0);
            border: 2px solid #8a9a7e;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .score-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .score-title {
            font-weight: bold;
            color: #6b7f5e;
        }

        .current-points {
            font-size: 28px;
            font-weight: bold;
            color: #6b7f5e;
        }

        .penalty-info {
            font-size: 11px;
            color: #8a9a7e;
        }

        .hints-box {
            background: #e8ebe4;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
            border: 1px solid #8a9a7e;
        }

        .hints-header {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: bold;
            color: #6b7f5e;
            margin-bottom: 12px;
        }

        .hint-item {
            color: #6b7f5e;
            font-size: 14px;
            margin-bottom: 8px;
            padding-left: 12px;
        }

        .hint-button {
            width: 100%;
            background: #8a9a7e;
            color: #f5f5f0;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            transition: background 0.3s, transform 0.2s;
        }

        .hint-button:hover {
            background: #6b7f5e;
            transform: scale(1.02);
        }

        .input-group {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
        }

        input[type="number"] {
            flex: 1;
            padding: 15px;
            border: 2px solid #8a9a7e;
            border-radius: 8px;
            font-size: 18px;
            transition: border 0.3s;
            background: #f5f5f0;
            color: #6b7f5e;
        }

        input[type="number"]:focus {
            outline: none;
            border-color: #6b7f5e;
        }

        .guess-button {
            background: #6b7f5e;
            color: #f5f5f0;
            border: none;
            padding: 15px 30px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s, transform 0.2s;
        }

        .guess-button:hover {
            background: #5a6e4d;
            transform: scale(1.05);
        }

        .message-box {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 15px;
            font-weight: 500;
        }

        .message-info {
            background: #e8ebe4;
            color: #6b7f5e;
            border: 1px solid #8a9a7e;
        }

        .message-success {
            background: #8a9a7e;
            color: #f5f5f0;
        }

        .win-box {
            text-align: center;
            padding: 30px;
            background: linear-gradient(135deg, #8a9a7e, #6b7f5e);
            border-radius: 12px;
            margin-bottom: 20px;
            color: #f5f5f0;
        }

        .trophy {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .win-title {
            font-size: 24px;
            font-weight: bold;
            color: #f5f5f0;
            margin-bottom: 10px;
        }

        .win-details {
            color: #f5f5f0;
            margin-bottom: 5px;
        }

        .button-group {
            display: flex;
            gap: 10px;
        }

        .btn-next {
            flex: 1;
            background: linear-gradient(135deg, #6b7f5e, #8a9a7e);
            color: #f5f5f0;
            border: none;
            padding: 15px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .btn-next:hover {
            transform: scale(1.05);
        }

        .btn-retry {
            flex: 1;
            background: #8a9a7e;
            color: #f5f5f0;
            border: none;
            padding: 15px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }

        .btn-retry:hover {
            background: #6b7f5e;
        }

        .guesses-box {
            margin-top: 20px;
        }

        .guesses-label {
            font-size: 13px;
            font-weight: bold;
            color: #6b7f5e;
            margin-bottom: 10px;
        }

        .guesses-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .guess-tag {
            background: #e8ebe4;
            color: #6b7f5e;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            border: 1px solid #8a9a7e;
        }

        .footer {
            text-align: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #e8ebe4;
            color: #8a9a7e;
            font-size: 11px;
        }
    </style>
</head>
<body class="bg-level-1" id="body">
    <div class="container">
        <div class="header">
            <div class="level-info">
                <div class="level-badge">
                    <span id="levelIcon">⭐</span>
                    <span id="levelText">Level 1: Easy</span>
                </div>
                <div class="score-box">
                    <div class="score-label">Total Score</div>
                    <div class="score-value" id="totalScore">0</div>
                </div>
            </div>
            <div style="font-size: 40px;">✨</div>
            <h1 class="title">Mystery Number Game</h1>
            <p class="subtitle">Guess the 2-digit number!</p>
        </div>

        <div id="gameArea">
            <div class="current-score-box">
                <div class="score-row">
                    <span class="score-title">Current Round Score:</span>
                    <span class="current-points" id="currentScore">100</span>
                </div>
                <div class="penalty-info">
                    • Each wrong guess: -5 points<br>
                    • Each hint reveal: -15 points
                </div>
            </div>

            <div class="hints-box">
                <div class="hints-header">
                    <span id="hintIcon">💡</span>
                    <span id="hintCounter">Hints (1/4):</span>
                </div>
                <div id="hintsContainer"></div>
                <button class="hint-button" id="revealHintBtn" onclick="revealNextHint()">
                    💡 Reveal Next Hint (-15 points)
                </button>
            </div>

            <div class="input-group" id="inputGroup">
                <input type="number" id="guessInput" placeholder="Enter 10-99" min="10" max="99">
                <button class="guess-button" onclick="makeGuess()">Guess</button>
            </div>

            <div id="messageBox" style="display: none;"></div>

            <div class="guesses-box" id="guessesBox" style="display: none;">
                <div class="guesses-label">Your guesses (<span id="guessCount">0</span>):</div>
                <div class="guesses-list" id="guessesList"></div>
            </div>
        </div>

        <div id="winArea" style="display: none;">
            <div class="win-box">
                <div class="trophy">🏆</div>
                <div class="win-title" id="winMessage"></div>
                <div class="win-details">The number was <span id="correctNumber"></span>!</div>
                <div class="win-details">Guesses: <span id="finalGuesses"></span></div>
                <div class="win-details">Hints used: <span id="finalHints"></span></div>
            </div>
            <div class="button-group">
                <button class="btn-next" id="nextBtn" onclick="nextLevel()">Next Level →</button>
                <button class="btn-retry" onclick="retryLevel()">Retry Level</button>
            </div>
        </div>

        <div class="footer">
            Challenge yourself! Use fewer hints and guesses for maximum points! 🏆
        </div>
    </div>

    <script>
        const levelData = {
            1: {
                name: "Easy",
                color: "bg-level-1",
                icon: "⭐",
                mysteries: [
                    { number: 25, hints: ["It's a winter holiday in December", "Santa Claus delivers presents", "Jesus Christ's birthday celebration", "December 25th - Christmas Day"] },
                    { number: 31, hints: ["Spooky night with costumes", "Kids say 'trick or treat'", "October's last day", "Halloween - October 31st"] },
                    { number: 14, hints: ["Day of love and romance", "Cupid shoots arrows", "Roses and chocolate boxes", "Valentine's Day - February 14th"] },
                    { number: 26, hints: ["India became a republic", "Grand parade at Rajpath, Delhi", "Constitution came into effect", "Republic Day - January 26th"] },
                    { number: 15, hints: ["India's freedom from British rule", "Tricolor flag hoisting day", "Jawaharlal Nehru's famous speech", "Independence Day - August 15th"] }
                ]
            },
            2: {
                name: "Medium",
                color: "bg-level-2",
                icon: "⭐",
                mysteries: [
                    { number: 23, hints: ["NBA legend's jersey number", "Won 6 championships with Bulls", "His Airness, the GOAT", "Michael Jordan - #23"] },
                    { number: 10, hints: ["Soccer's greatest player", "Argentina's World Cup hero 2022", "8 Ballon d'Or awards", "Lionel Messi - #10"] },
                    { number: 42, hints: ["Supercomputer's answer in sci-fi", "Life, universe, and everything", "Douglas Adams' famous book", "Hitchhiker's Guide - 42"] },
                    { number: 56, hints: ["India's telecom revolution year", "Mobile phones became common", "STD booths everywhere", "Year 1956 - telecom milestone"] },
                    { number: 99, hints: ["Hockey legend's number", "The Great One from Canada", "Most NHL records holder", "Wayne Gretzky - #99"] }
                ]
            },
            3: {
                name: "Hard",
                color: "bg-level-3",
                icon: "⭐",
                mysteries: [
                    { number: 27, hints: ["Perfect cube number", "Lives lost in famous club tragedy", "3 × 3 × 3", "The 27 Club - cursed age"] },
                    { number: 73, hints: ["Sheldon Cooper calls it perfect", "Its mirror 37 is also prime", "Binary: 1001001", "Best number according to Big Bang Theory"] },
                    { number: 47, hints: ["Star Trek's recurring number", "15th prime number", "Appears in every episode", "The 47 Society - Pomona College"] },
                    { number: 69, hints: ["Yin-yang balance position", "Internet's favorite number", "Sum of three consecutive primes", "Nice number meme culture"] },
                    { number: 88, hints: ["Lucky in Chinese culture", "Looks like infinity twice", "Piano keys count", "Back to the Future speed"] }
                ]
            },
            4: {
                name: "Expert",
                color: "bg-level-4",
                icon: "⭐",
                mysteries: [
                    { number: 37, hints: ["Body temperature in Celsius", "First irregular prime", "Unique prime property", "Appears in many patterns"] },
                    { number: 54, hints: ["Cards in a deck with jokers", "3³ × 2", "Studio 54 famous club", "Atomic number of Xenon"] },
                    { number: 61, hints: ["Minutes in an hour plus one", "Twin prime with 59", "6th centered hexagonal number", "Curie's atomic number"] },
                    { number: 89, hints: ["11th Fibonacci number", "Mersenne prime exponent", "Largest 2-digit prime", "Actinium's atomic number"] },
                    { number: 92, hints: ["Atomic number of Uranium", "Number of natural elements", "Piano keys on standard keyboard", "Regular polyhedra vertices"] }
                ]
            },
            5: {
                name: "Master",
                color: "bg-level-5",
                icon: "🔥",
                mysteries: [
                    { number: 41, hints: ["Sum of first 6 primes", "13th smallest prime", "Centered square number", "Newman-Shanks-Williams prime"] },
                    { number: 67, hints: ["19th prime number", "Twin prime with 71 nearby", "3-smooth number plus 3", "Atomic number of Holmium"] },
                    { number: 83, hints: ["23rd prime number", "Sophie Germain prime", "Sum of five consecutive primes", "Atomic number of Bismuth"] },
                    { number: 71, hints: ["20th prime number", "Largest number on roulette wheel", "Pillars of wisdom in Confucius", "Lutetium's atomic number"] },
                    { number: 97, hints: ["25th prime number", "Largest 2-digit prime", "Chen prime and Eisenstein prime", "Berkelium's atomic number"] }
                ]
            }
        };

        let currentLevel = 1;
        let currentMystery = null;
        let guesses = [];
        let hintsRevealed = 0;
        let currentScore = 100;
        let totalScore = 0;
        let won = false;

        // ANIMATION FUNCTIONS - ALL DEBUGGED

        // Enhanced Confetti with Multiple Shapes
        function createConfetti() {
            const colors = ['#6b7f5e', '#8a9a7e', '#e8ebe4', '#ffd700', '#95e1d3'];
            const confettiCount = 150;

            for (let i = 0; i < confettiCount; i++) {
                setTimeout(() => {
                    const confetti = document.createElement('div');
                    confetti.className = 'confetti';
                    confetti.style.left = Math.random() * window.innerWidth + 'px';
                    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                    confetti.style.width = (Math.random() * 12 + 5) + 'px';
                    confetti.style.height = (Math.random() * 12 + 5) + 'px';
                    confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '0%';
                    confetti.style.animationDuration = (Math.random() * 2 + 2) + 's';
                    confetti.style.animationDelay = (Math.random() * 0.5) + 's';
                    
                    document.body.appendChild(confetti);

                    setTimeout(() => {
                        confetti.remove();
                    }, 5000);
                }, i * 10);
            }
        }

        // FIXED: Fireworks Effect
        function createFireworks() {
            const colors = ['#ffd700', '#ff6b6b', '#4ecdc4', '#95e1d3', '#f38181'];
            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;

            for (let burst = 0; burst < 3; burst++) {
                setTimeout(() => {
                    for (let i = 0; i < 50; i++) {
                        const firework = document.createElement('div');
                        firework.className = 'firework';
                        
                        const angle = (i / 50) * Math.PI * 2;
                        const velocity = 100 + Math.random() * 100;
                        const fx = Math.cos(angle) * velocity;
                        const fy = Math.sin(angle) * velocity;
                        
                        firework.style.left = centerX + 'px';
                        firework.style.top = centerY + 'px';
                        firework.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                        firework.style.setProperty('--fx', fx + 'px');
                        firework.style.setProperty('--fy', fy + 'px');
                        
                        // FIXED: Apply animation properly
                        const duration = 1 + Math.random();
                        firework.style.animation = `firework-burst ${duration}s ease-out forwards`;
                        
                        document.body.appendChild(firework);

                        // FIXED: Match cleanup time with animation duration
                        setTimeout(() => firework.remove(), duration * 1000 + 100);
                    }
                }, burst * 400);
            }
        }

        // FIXED: Success Particle Burst
        function createSuccessParticles() {
            const container = document.querySelector('.container');
            const rect = container.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const colors = ['#6b7f5e', '#ffd700', '#4ecdc4'];

            for (let i = 0; i < 80; i++) {
                const particle = document.createElement('div');
                particle.className = 'success-particle';
                
                const angle = (i / 80) * Math.PI * 2;
                const distance = 200 + Math.random() * 150;
                const x = Math.cos(angle) * distance;
                const y = Math.sin(angle) * distance;
                
                particle.style.left = centerX + 'px';
                particle.style.top = centerY + 'px';
                particle.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                particle.style.setProperty('--x', x + 'px');
                particle.style.setProperty('--y', y + 'px');
                
                // FIXED: Apply animation correctly
                const duration = 1 + Math.random() * 0.5;
                particle.style.animation = `particle-burst ${duration}s ease-out forwards`;
                
                document.body.appendChild(particle);

                setTimeout(() => particle.remove(), duration * 1000 + 100);
            }
        }

        // Star Rain for Correct Answer
        function createStarRain() {
            const stars = ['⭐', '✨', '🌟', '💫', '⭐'];
            
            for (let i = 0; i < 15; i++) {
                setTimeout(() => {
                    const star = document.createElement('div');
                    star.className = 'star-particle';
                    star.textContent = stars[Math.floor(Math.random() * stars.length)];
                    star.style.left = (20 + Math.random() * 60) + '%';
                    star.style.top = '80%';
                    
                    document.body.appendChild(star);

                    setTimeout(() => star.remove(), 2100);
                }, i * 100);
            }
        }

        // Enhanced Sad Emojis
        function createSadEmojis() {
            const emojis = ['😢', '😞', '😔', '😿', '💔', '😭', '😩', '🥺'];
            const emojiCount = 8;

            for (let i = 0; i < emojiCount; i++) {
                setTimeout(() => {
                    const emoji = document.createElement('div');
                    emoji.className = 'sad-emoji';
                    emoji.textContent = emojis[Math.floor(Math.random() * emojis.length)];
                    emoji.style.left = Math.random() * (window.innerWidth - 60) + 'px';
                    emoji.style.top = '-100px';
                    
                    document.body.appendChild(emoji);

                    setTimeout(() => emoji.remove(), 2100);
                }, i * 150);
            }
        }

        // Lightning Flash for Wrong Answer
        function createLightningFlash() {
            const lightning = document.createElement('div');
            lightning.className = 'lightning';
            document.body.appendChild(lightning);
            
            setTimeout(() => lightning.remove(), 550);
        }

        // Floating Wrong Number Animation
        function createFloatingNumber(number) {
            const container = document.querySelector('.container');
            const rect = container.getBoundingClientRect();
            
            for (let i = 0; i < 3; i++) {
                setTimeout(() => {
                    const floatNum = document.createElement('div');
                    floatNum.className = 'floating-number';
                    floatNum.textContent = '✗ ' + number;
                    floatNum.style.left = (rect.left + Math.random() * rect.width) + 'px';
                    floatNum.style.top = (rect.top + rect.height / 2) + 'px';
                    
                    document.body.appendChild(floatNum);

                    setTimeout(() => floatNum.remove(), 2100);
                }, i * 200);
            }
        }

        // FIXED: Sparkle Effect for Hint Reveal
        function createSparkles() {
            const hintsBox = document.querySelector('.hints-box');
            const rect = hintsBox.getBoundingClientRect();
            const sparkleSymbols = ['✨', '💡', '⭐', '🌟'];

            for (let i = 0; i < 12; i++) {
                setTimeout(() => {
                    const sparkle = document.createElement('div');
                    sparkle.className = 'sparkle';
                    sparkle.textContent = sparkleSymbols[Math.floor(Math.random() * sparkleSymbols.length)];
                    sparkle.style.left = (rect.left + Math.random() * rect.width) + 'px';
                    sparkle.style.top = (rect.top + rect.height / 2) + 'px';
                    
                    const sx = (Math.random() - 0.5) * 100;
                    sparkle.style.setProperty('--sx', sx + 'px');
                    
                    document.body.appendChild(sparkle);

                    setTimeout(() => sparkle.remove(), 1600);
                }, i * 80);
            }
        }

        function shakeElement(element) {
            element.classList.add('shake-animation');
            setTimeout(() => element.classList.remove('shake-animation'), 500);
        }

        function bounceElement(element) {
            element.classList.add('bounce-animation');
            setTimeout(() => element.classList.remove('bounce-animation'), 1000);
        }

        function pulseElement(element) {
            element.classList.add('pulse-animation');
            setTimeout(() => element.classList.remove('pulse-animation'), 500);
        }

        function scaleUpElement(element) {
            element.classList.add('scale-up-animation');
            setTimeout(() => element.classList.remove('scale-up-animation'), 600);
        }

        function glowElement(element) {
            element.classList.add('glow-animation');
            setTimeout(() => element.classList.remove('glow-animation'), 1000);
        }

        function rainbowBorder(element) {
            element.classList.add('rainbow-border');
            setTimeout(() => element.classList.remove('rainbow-border'), 1000);
        }

        function redFlash(element) {
            element.classList.add('red-flash');
            setTimeout(() => element.classList.remove('red-flash'), 500);
        }

        function startNewGame() {
            const mysteries = levelData[currentLevel].mysteries;
            currentMystery = mysteries[Math.floor(Math.random() * mysteries.length)];
            guesses = [];
            hintsRevealed = 0;
            currentScore = 100;
            won = false;

            document.getElementById('gameArea').style.display = 'block';
            document.getElementById('winArea').style.display = 'none';
            document.getElementById('guessInput').value = '';
            document.getElementById('messageBox').style.display = 'none';
            document.getElementById('guessesBox').style.display = 'none';
            document.getElementById('guessesList').innerHTML = '';
            
            updateLevelDisplay();
            displayHints();
            updateScore();
        }

        function updateLevelDisplay() {
            const levelInfo = levelData[currentLevel];
            document.getElementById('levelText').textContent = `Level ${currentLevel}: ${levelInfo.name}`;
            document.getElementById('levelIcon').textContent = levelInfo.icon;
            document.body.className = levelInfo.color;
            document.getElementById('totalScore').textContent = totalScore;
        }

        function displayHints() {
            const container = document.getElementById('hintsContainer');
            container.innerHTML = '';
            
            for (let i = 0; i <= hintsRevealed && i < currentMystery.hints.length; i++) {
                const hint = document.createElement('div');
                hint.className = 'hint-item';
                hint.textContent = '• ' + currentMystery.hints[i];
                
                // Add reveal animation to newly revealed hint
                if (i === hintsRevealed && hintsRevealed > 0) {
                    hint.classList.add('hint-reveal');
                }
                
                container.appendChild(hint);
            }

            document.getElementById('hintCounter').textContent = 
                `Hints (${hintsRevealed + 1}/${currentMystery.hints.length}):`;

            if (hintsRevealed >= currentMystery.hints.length - 1) {
                document.getElementById('revealHintBtn').style.display = 'none';
            } else {
                document.getElementById('revealHintBtn').style.display = 'block';
            }
        }

        function revealNextHint() {
            if (hintsRevealed < currentMystery.hints.length - 1) {
                hintsRevealed++;
                currentScore = Math.max(currentScore - 15, 0);
                displayHints();
                updateScore();
                showMessage('💡 New hint revealed! -15 points', 'info');
                
                // ENHANCED HINT ANIMATIONS
                createSparkles();
                pulseElement(document.querySelector('.hints-box'));
                
                const hintIcon = document.getElementById('hintIcon');
                hintIcon.classList.add('bulb-glow');
                setTimeout(() => {
                    hintIcon.classList.remove('bulb-glow');
                }, 800);
            }
        }

        function updateScore() {
            document.getElementById('currentScore').textContent = currentScore;
            document.getElementById('totalScore').textContent = totalScore;
        }

        function showMessage(text, type) {
            const messageBox = document.getElementById('messageBox');
            messageBox.textContent = text;
            messageBox.className = type === 'success' ? 'message-box message-success' : 'message-box message-info';
            messageBox.style.display = 'block';
            
            pulseElement(messageBox);
        }

        function makeGuess() {
            if (won) return;

            const input = document.getElementById('guessInput');
            const guess = parseInt(input.value);

            if (!input.value || isNaN(guess) || guess < 10 || guess > 99) {
                showMessage('⚠️ Please enter a valid 2-digit number (10-99)', 'info');
                shakeElement(document.getElementById('inputGroup'));
                return;
            }

            if (guesses.includes(guess)) {
                showMessage('⚠️ You already guessed that number!', 'info');
                shakeElement(document.getElementById('inputGroup'));
                return;
            }

            guesses.push(guess);
            currentScore = Math.max(currentScore - 5, 0);
            updateScore();

            const guessesList = document.getElementById('guessesList');
            const tag = document.createElement('span');
            tag.className = 'guess-tag';
            tag.textContent = guess;
            guessesList.appendChild(tag);

            document.getElementById('guessesBox').style.display = 'block';
            document.getElementById('guessCount').textContent = guesses.length;

            if (guess === currentMystery.number) {
                won = true;
                totalScore += currentScore;
                updateScore();
                
                // MASSIVE CORRECT ANSWER CELEBRATION!
                createConfetti();
                createFireworks();
                createSuccessParticles();
                createStarRain();
                bounceElement(document.querySelector('.container'));
                scaleUpElement(document.querySelector('.container'));
                glowElement(document.querySelector('.container'));
                rainbowBorder(document.getElementById('inputGroup'));
                pulseElement(document.getElementById('totalScore'));
                pulseElement(document.getElementById('currentScore'));
                
                setTimeout(() => showWin(), 500);
            } else {
                // ENHANCED WRONG ANSWER ANIMATIONS
                shakeElement(document.getElementById('inputGroup'));
                redFlash(document.querySelector('.container'));
                createSadEmojis();
                createLightningFlash();
                createFloatingNumber(guess);
                shakeElement(document.querySelector('.current-score-box'));
                
                if (guess < currentMystery.number) {
                    showMessage('📈 Too low! Try a higher number. -5 points', 'info');
                } else {
                    showMessage('📉 Too high! Try a lower number. -5 points', 'info');
                }
            }

            input.value = '';
        }

        function showWin() {
            document.getElementById('gameArea').style.display = 'none';
            document.getElementById('winArea').style.display = 'block';
            document.getElementById('winMessage').textContent = `🎉 Correct! You earned ${currentScore} points!`;
            document.getElementById('correctNumber').textContent = currentMystery.number;
            document.getElementById('finalGuesses').textContent = guesses.length;
            document.getElementById('finalHints').textContent = `${hintsRevealed + 1}/${currentMystery.hints.length}`;

            const nextBtn = document.getElementById('nextBtn');
            if (currentLevel < 5) {
                nextBtn.textContent = 'Next Level →';
                nextBtn.className = 'btn-next';
            } else {
                nextBtn.textContent = '🏆 Play Again';
                nextBtn.style.background = 'linear-gradient(135deg, #6b7f5e, #8a9a7e)';
            }
            
            // Animate win box
            bounceElement(document.querySelector('.win-box'));
        }

        function nextLevel() {
            if (currentLevel < 5) {
                currentLevel++;
            } else {
                currentLevel = 1;
                totalScore = 0;
            }
            startNewGame();
        }

        function retryLevel() {
            startNewGame();
        }

        document.getElementById('guessInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                makeGuess();
            }
        });

        // Start the game
        startNewGame();
    </script>
</body>
</html>
